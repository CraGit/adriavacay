# Prismic
NEXT_PUBLIC_PRISMIC_ENVIRONMENT=

# Public site URL (used by sitemap, Stripe success/cancel URLs)
NEXT_PUBLIC_BASE_URL=https://adriavacay.com

# Optional legacy / local URL reference
SITE_URL=http://localhost:3000

# SMTP (booking + contact forms)
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_TO=
MAIL_FROM=

# Local testing with Ethereal (https://ethereal.email):
# MAIL_HOST=smtp.ethereal.email
# MAIL_PORT=587
# MAIL_SECURE=false   # must be false on 587 (STARTTLS); true only for port 465
# MAIL_USER=<from ethereal.email/create or npm run mail:ethereal>
# MAIL_PASSWORD=<from ethereal.email/create or npm run mail:ethereal>
# MAIL_FROM=AdriaVacay <same-as-MAIL_USER>
# MAIL_TO=any-address@example.com

# MyRent availability API (read)
MYRENT_USER_GUID=
MYRENT_B2B_GUID=

# MyRent write API (bookings)
# 1) POST https://auth.my-rent.net/auth/generate with headers: user_guid + Authorization
# 2) Send returned token as the `token` request header on rent_add / rent_save / rent_del
MYRENT_USER_ID=
MYRENT_API_PUBLIC_KEY=
MYRENT_API_AUTH_KEY=
# Authorization header value for auth/generate (required — contact MyRent if missing)
MYRENT_API_AUTH=
# Optional IDs from your MyRent account (website source, EUR currency)
MYRENT_RENT_SOURCE_ID=
MYRENT_CURRENCY_ID=2
# Payment method IDs (optional). Stripe/bank-specific override the shared fallback.
# Stripe success: in_advance_paid=Y; paid=Y only when 100% charged (else partial).
# Bank transfer: hold stays unpaid — mark paid manually in MyRent after wire arrives.
MYRENT_PAYMENT_METHOD_ID=
MYRENT_PAYMENT_METHOD_ID_STRIPE=
MYRENT_PAYMENT_METHOD_ID_BANK=

# Stripe Checkout (prefer a restricted secret key)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Bank transfer details (shown in guest email)
BANK_IBAN=
BANK_BENEFICIARY=
BANK_NAME=
# Optional prefix prepended to erp_id in the payment reference
BANK_REFERENCE_PREFIX=

# Mailchimp newsletter (optional — form returns an error if unset)
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER=

# On-demand Prismic cache revalidation (POST /api/revalidate)
# Send as Authorization: Bearer <secret> or ?secret=<secret>
REVALIDATE_SECRET=
