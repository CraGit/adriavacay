# Prismic
NEXT_PUBLIC_PRISMIC_ENVIRONMENT=

# Public site URL (used by sitemap, Stripe success/cancel URLs)
NEXT_PUBLIC_BASE_URL=https://adriavacay.com

# Optional legacy / local URL reference
SITE_URL=http://localhost:3000

# SMTP (booking + contact forms)
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_TO=
MAIL_FROM=

# MyRent availability API (read)
MYRENT_USER_GUID=
MYRENT_B2B_GUID=

# MyRent write API (bookings) — auth.my-rent.net token
MYRENT_USER_ID=
MYRENT_API_PUBLIC_KEY=
MYRENT_API_AUTH_KEY=
# Optional Authorization header value if your MyRent account requires it
MYRENT_API_AUTH=
# Optional IDs from your MyRent account (website source, EUR currency, payment method)
MYRENT_RENT_SOURCE_ID=
MYRENT_CURRENCY_ID=2
MYRENT_PAYMENT_METHOD_ID=

# Stripe Checkout (prefer a restricted secret key)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Bank transfer details (shown in guest email)
BANK_IBAN=
BANK_BENEFICIARY=
BANK_NAME=
# Optional prefix prepended to erp_id in the payment reference
BANK_REFERENCE_PREFIX=

# Mailchimp newsletter (optional — form returns an error if unset)
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER=

# On-demand Prismic cache revalidation (POST /api/revalidate)
# Send as Authorization: Bearer <secret> or ?secret=<secret>
REVALIDATE_SECRET=
